{
  // This file exists because its absence shipped a broken build.
  //
  // `bunx tsc --noEmit` with no tsconfig and no file arguments does not fail —
  // it prints the compiler's help text and exits 0. That was read as "typechecks
  // clean" while server.ts contained `ReferenceError: senderContextId is not
  // defined`, which broke EVERY inbound message in 0.11.0. A checker that cannot
  // go red is a comment claiming safety.
  //
  // `bun run typecheck` now checks server.ts for real. Run it before publishing.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "strict": true,
    // The file is written against `any`-typed WS frames by design (they are
    // untrusted wire data), so implicit-any noise would drown the real errors.
    // What matters here is scope and typo detection, which stays on.
    "noImplicitAny": false,
    "allowJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "forceConsistentCasingInFileNames": true
  },
  // Widened 2026-07-29 from ["server.ts"]. The hook that publishes this
  // plugin's session identity sat outside every check in the repo — no
  // typecheck, no test — and was a no-op in every session from the day it
  // shipped. Narrow scope is how the same phantom-green recurs in a new file.
  "include": ["server.ts", "hooks/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules"]
}
